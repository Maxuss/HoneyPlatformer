    - target: {fileID: 3639972541712989167, guid: 836ac5f563cf6f5b4ac57e0c233c9efa, type: 3}
      propertyPath: text
      value: "\u0421\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043E\u0442
        13.03.2###\n\n\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u0435 \u0443\u0436\u0435
        \u043F\u0440\u043E\u0432\u043E\u0434\u043A\u0443 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u0445!
        \u042F \u0443\u0441\u0442\u0430\u044E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C \u0432 <color=#a3f7ed>\u0440\u0435\u0436\u0438\u043C
        \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F</color>
        \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u0443\u0437\u043B\u044B!
        \u0422\u0430\u043A\u0438\u043C\u0438 \u0442\u0435\u043C\u043F\u0430\u043C\u0438
        \u043F\u0440\u043E\u0435\u043A\u0442 <color=#f7a3ad>(\u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
        \u0434\u0430\u043D\u043D\u044B\u0435)</color> \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D!"
      objectReference: {fileID: 0}
